{
  "name": "demand-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "cross-env VITE_DEMO_MODE=true vite build --outDir dist-demo",
    "preview:demo": "vite preview --outDir dist-demo",
    "lint": "eslint .",
    "preview": "vite preview",
    "solution:pack": "pac solution pack --zipfile solution/out/IntakeForms.zip --folder solution/src --packagetype Both",
    "solution:check": "pac solution unpack --zipfile solution/out/IntakeForms.zip --folder solution/out/roundtrip --packagetype Both"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@mantine/core": "^9.2.1",
    "@mantine/dates": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@mantine/notifications": "^9.2.1",
    "@microsoft/power-apps": "^1.1.3",
    "@tabler/icons-react": "^3.44.0",
    "dayjs": "^1.11.20",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/power-apps-vite": "^1.0.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.61.0",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "overrides": {
    "rolldown": "1.0.2"
  }
}
